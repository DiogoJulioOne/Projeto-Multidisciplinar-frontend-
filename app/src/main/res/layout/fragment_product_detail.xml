<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- VOLTAR -->

        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Voltar"
            android:textSize="14sp" />

        <!-- FOTO -->

        <ImageView
            android:id="@+id/imgProduto"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background" />

        <!-- TÍTULO -->

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Nome do produto"
            android:textColor="#222222"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- LOCALIZAÇÃO -->

        <TextView
            android:id="@+id/tvLocalizacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📍 Localização"
            android:textColor="#666666"
            android:textSize="16sp" />

        <!-- DIVISÓRIA -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#D0D8D0" />

        <!-- INFORMAÇÕES -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Informações do produto"
            android:textColor="#2E7D32"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- CATEGORIA -->

        <TextView
            android:id="@+id/tvCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="🏷️ Categoria: Eletrônicos"
            android:textColor="#444444"
            android:textSize="16sp" />

        <!-- ESTADO -->

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📦 Estado: Usado"
            android:textColor="#444444"
            android:textSize="16sp" />

        <!-- QUANTIDADE -->

        <TextView
            android:id="@+id/tvQuantidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🔢 Quantidade: 1"
            android:textColor="#444444"
            android:textSize="16sp" />

        <!-- DESCRIÇÃO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Descrição"
            android:textColor="#2E7D32"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Descrição do produto..."
            android:textColor="#444444"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />

        <!-- BOTÃO -->

        <Button
            android:id="@+id/btnTenhoInteresse"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"
            android:text="TENHO INTERESSE ♻️"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>