<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Logo -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ReMatch ♻️"
            android:textColor="#2E7D32"
            android:textSize="28sp"
            android:textStyle="bold" />


        <!-- Saudação -->

        <TextView
            android:id="@+id/tvSaudacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Olá! 👋"
            android:textColor="#222222"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Esse é o seu espaço no ReMatch."
            android:textColor="#666666"
            android:textSize="15sp" />


        <!-- Perfil -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="#E8F3EC"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤  Meu perfil"
                android:textColor="#222222"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNomeUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Seu nome"
                android:textColor="#2E7D32"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLocalizacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="📍 Sua localização"
                android:textColor="#666666"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Conte um pouco sobre você..."
                android:textColor="#555555"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnEditarPerfil"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:text="EDITAR PERFIL" />

        </LinearLayout>


        <!-- Opções -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="O que você deseja fazer?"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold" />


        <!-- Publicar -->

        <Button
            android:id="@+id/btnPublicarMaterial"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="15dp"
            android:text="📦  PUBLICAR MATERIAL"
            android:textSize="15sp"
            android:textStyle="bold" />


        <!-- Buscar -->

        <Button
            android:id="@+id/btnBuscarMateriais"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:text="🔎  BUSCAR MATERIAIS"
            android:textSize="15sp"
            android:textStyle="bold" />


        <!-- Meus anúncios -->

        <Button
            android:id="@+id/btnMeusMateriais"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:text="📋  MEUS ANÚNCIOS"
            android:textSize="15sp"
            android:textStyle="bold" />


        <!-- Matches -->

        <Button
            android:id="@+id/btnMatches"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:text="🔄  MEUS MATCHES"
            android:textSize="15sp"
            android:textStyle="bold" />


        <!-- Configurações -->

        <Button
            android:id="@+id/btnConfiguracoes"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="25dp"
            android:text="⚙️  CONFIGURAÇÕES"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>