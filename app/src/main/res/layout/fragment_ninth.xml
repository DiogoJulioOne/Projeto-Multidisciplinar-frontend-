<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F3EC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Configurações"
            android:textColor="#222222"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Gerencie suas preferências"
            android:textColor="#666666"
            android:textSize="15sp" />


        <Button
            android:id="@+id/btnNotificacoes"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="35dp"
            android:gravity="start|center_vertical"
            android:text="🔔  Notificações"
            android:textColor="#222222"
            android:textSize="15sp" />


        <Button
            android:id="@+id/btnPrivacidade"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:gravity="start|center_vertical"
            android:text="🔒  Privacidade"
            android:textColor="#222222"
            android:textSize="15sp" />


        <Button
            android:id="@+id/btnAjuda"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:gravity="start|center_vertical"
            android:text="❓  Ajuda"
            android:textColor="#222222"
            android:textSize="15sp" />


        <Button
            android:id="@+id/btnTermos"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:gravity="start|center_vertical"
            android:text="📄  Termos de uso"
            android:textColor="#222222"
            android:textSize="15sp" />


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="35dp"
            android:background="#CCD8CE" />


        <!-- Voltar para o perfil -->

        <Button
            android:id="@+id/btnVoltarPerfil"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:text="←  VOLTAR AO PERFIL"
            android:textColor="#2E7D32"
            android:textSize="15sp"
            android:textStyle="bold" />


        <!-- Sair -->

        <Button
            android:id="@+id/btnSair"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="30dp"
            android:gravity="start|center_vertical"
            android:text="🚪  Sair da conta"
            android:textColor="#B3261E"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>