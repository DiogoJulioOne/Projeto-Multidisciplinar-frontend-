<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Editar perfil ✏️"
            android:textColor="#2E7D32"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Atualize suas informações"
            android:textColor="#666666"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/imgFotoPerfil"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:background="#DCE8DD"
            android:contentDescription="Foto de perfil"
            android:scaleType="centerCrop" />

        <Button
            android:id="@+id/btnSelecionarFotoPerfil"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="ALTERAR FOTO"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtNomePerfil"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:hint="Nome"
            android:inputType="textPersonName"
            android:textColor="#333333"
            android:textColorHint="#666666"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edtLocalizacaoPerfil"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:hint="Localização"
            android:inputType="text"
            android:textColor="#333333"
            android:textColorHint="#666666"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edtDescricaoPerfil"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="Fale um pouco sobre você"
            android:inputType="textMultiLine"
            android:textColor="#333333"
            android:textColorHint="#666666"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnSalvarPerfil"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="22dp"
            android:text="SALVAR ALTERAÇÕES"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVoltarPerfil"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="30dp"
            android:text="VOLTAR"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>